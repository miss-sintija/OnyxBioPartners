<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {% include "partials/seo.njk" %}
    {% include "partials/structured-data.njk" %}
    <link rel="stylesheet" href="{{ viteAssets.css }}" />
</head>
<body class="{% if bodyClass %}{{ bodyClass }}{% endif %}">
    <div class="bg-orb orb-1" aria-hidden="true"></div>
    <div class="bg-orb orb-2" aria-hidden="true"></div>
    <div class="bg-grid" aria-hidden="true"></div>

    {% include "partials/nav.njk" %}

    <main id="top" class="page">
        {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}

    <script type="module" src="{{ viteAssets.js }}"></script>
    <script>
        (function () {
            var h = window.location.hash;
            if (/(invite_token|confirmation_token|recovery_token|email_change_token)=/.test(h)) {
                window.location.replace('/admin/' + h);
            }
        }());
    </script>
</body>
</html>
