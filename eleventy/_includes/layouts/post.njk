---
layout: layouts/base.njk
bodyClass: page--post
---
<article class="post">
    {% if featured_image %}
        <div class="post__hero" role="img" aria-label="{{ featured_image_alt or title }}" style="background-image: linear-gradient(180deg, rgba(11,7,18,0.0) 60%, rgba(11,7,18,0.55) 100%), url('{{ featured_image }}')"></div>
    {% else %}
        <div class="post__hero post__hero--blank" aria-hidden="true"></div>
    {% endif %}

    <div class="container post__container">
        <a href="/blog/" class="post__back">
            <span aria-hidden="true">←</span> Back to journal
        </a>

        <header class="post__header">
            <p class="post__date">
                <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
            </p>
            <h1 class="post__title">{{ title }}</h1>
            {% if excerpt %}<p class="post__lede">{{ excerpt }}</p>{% endif %}
        </header>

        <div class="prose">
            {{ content | safe }}
        </div>

        <footer class="post__footer">
            <a href="/blog/" class="btn btn--ghost btn--ghost-light">
                <span aria-hidden="true">←</span> All journal entries
            </a>
            <a href="/#contact" class="btn btn--primary">Talk to a partner <span aria-hidden="true">→</span></a>
        </footer>
    </div>
</article>
