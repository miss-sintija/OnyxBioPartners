{# ----------------------------------------------------------------------
   SEO meta partial. Used by base.njk for every Eleventy-rendered page.

   Reads from:
     - front matter: title, description, seo_title, seo_description,
                     og_image, og_image_alt, noindex
     - global site data (eleventy/_data/site.js)
     - page.url (Eleventy built-in) for canonical URLs
---------------------------------------------------------------------- #}

{%- set _seoTitle = seo_title or title -%}
{%- set _fullTitle -%}
    {%- if _seoTitle -%}{{ _seoTitle }} | {{ site.name }}{%- else -%}{{ site.name }} — {{ site.tagline }}{%- endif -%}
{%- endset -%}
{%- set _description = seo_description or description or excerpt or site.description -%}
{%- set _canonical = site.url + page.url -%}
{%- set _ogImage = og_image or featured_image or site.defaultOgImage -%}
{%- set _ogImageAbs -%}
    {%- if _ogImage.startsWith('http') -%}{{ _ogImage }}{%- else -%}{{ site.url }}{{ _ogImage }}{%- endif -%}
{%- endset -%}
{%- set _ogImageAlt = og_image_alt or featured_image_alt or site.defaultOgImageAlt -%}
{%- set _ogType = og_type or ('article' if page.url.startsWith('/blog/') and page.url != '/blog/' else 'website') -%}

<title>{{ _fullTitle }}</title>
<meta name="description" content="{{ _description }}" />
<link rel="canonical" href="{{ _canonical }}" />
{% if noindex %}<meta name="robots" content="noindex,nofollow" />{% endif %}

{# Open Graph #}
<meta property="og:type" content="{{ _ogType }}" />
<meta property="og:site_name" content="{{ site.name }}" />
<meta property="og:title" content="{{ _seoTitle or (site.name + ' — ' + site.tagline) }}" />
<meta property="og:description" content="{{ _description }}" />
<meta property="og:url" content="{{ _canonical }}" />
<meta property="og:locale" content="{{ site.locale }}" />
<meta property="og:image" content="{{ _ogImageAbs }}" />
<meta property="og:image:alt" content="{{ _ogImageAlt }}" />
{% if _ogType == 'article' and page.date %}
<meta property="article:published_time" content="{{ page.date | isoDate }}" />
{% endif %}

{# Twitter / X #}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ _seoTitle or (site.name + ' — ' + site.tagline) }}" />
<meta name="twitter:description" content="{{ _description }}" />
<meta name="twitter:image" content="{{ _ogImageAbs }}" />
<meta name="twitter:image:alt" content="{{ _ogImageAlt }}" />
{% if site.twitterHandle %}
<meta name="twitter:site" content="{{ site.twitterHandle }}" />
{% endif %}

{# Icons & theme — SVG is the primary favicon; PNGs are fallbacks for
   browsers that don't accept SVG, plus the iOS home-screen icon. All
   raster sizes are generated from favicon.svg by `npm run icons`. #}
<meta name="theme-color" content="{{ site.themeColor }}" />
<link rel="icon" type="image/svg+xml" href="{{ site.favicon }}" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
