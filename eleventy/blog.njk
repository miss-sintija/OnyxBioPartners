---
title: Journal
description: Insights from the front lines of life sciences strategy, regulation, and adoption.
permalink: /blog/index.html
layout: layouts/base.njk
isJournal: true
bodyClass: page--journal
---
<section class="journal section">
    <div class="container">
        <div class="journal__head">
            <p class="eyebrow">Journal</p>
            <h1 class="section-title">Insights from concept to market.</h1>
            <p class="section-sub">{{ description }}</p>
        </div>

        {% set posts = collections.posts | reverse %}
        {% if posts.length > 0 %}
            <div class="journal__grid">
                {% for post in posts %}
                    {% set p = post.data %}
                    <article class="post-card">
                        <a class="post-card__link" href="{{ post.url }}">
                            {% if p.featured_image %}
                                <div class="post-card__image" style="background-image: url('{{ p.featured_image }}')" aria-hidden="true"></div>
                            {% else %}
                                <div class="post-card__image post-card__image--blank" aria-hidden="true">
                                    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                                        <path d="M22 12c0 12 20 14 20 20s-20 8-20 20"/>
                                        <path d="M42 12c0 12-20 14-20 20s20 8 20 20"/>
                                        <path d="M24 18h16M23 24h18M23 40h18M24 46h16" opacity="0.6"/>
                                    </svg>
                                </div>
                            {% endif %}
                            <div class="post-card__body">
                                <p class="post-card__date">
                                    <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
                                </p>
                                <h2 class="post-card__title">{{ p.title }}</h2>
                                <p class="post-card__excerpt">
                                    {%- if p.excerpt -%}
                                        {{ p.excerpt }}
                                    {%- else -%}
                                        {{ post.templateContent | excerptify(180) }}
                                    {%- endif -%}
                                </p>
                                <span class="post-card__cta">Read article <span aria-hidden="true">→</span></span>
                            </div>
                        </a>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="journal__empty">
                <p>The journal is just getting started. New posts will appear here soon.</p>
            </div>
        {% endif %}
    </div>
</section>
